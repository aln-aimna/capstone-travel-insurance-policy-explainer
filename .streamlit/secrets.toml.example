# Copy to .streamlit/secrets.toml and fill in. secrets.toml is git-ignored.

# Claude (optional - without it the chatbot runs in offline mode)
ANTHROPIC_API_KEY = "sk-ant-..."

# Claim e-mail (optional - without it customers can still download the filled PDF)
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 587                       # 587 STARTTLS, 465 SSL
SMTP_USER = "your.address@gmail.com"
SMTP_PASSWORD = "xxxx xxxx xxxx xxxx" # Gmail: Google Account > Security > 2-Step Verification > App passwords
CLAIMS_TO = "claims-team@example.com" # where claims are sent; comma-separated for several
SEND_COPY_TO_CLAIMANT = true
